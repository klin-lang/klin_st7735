module klin_st7735

/// Panel / tab variant. Offsets stay caller-visible — not inferred from silicon.
pub enum Tab {
    /// 128×160, Adafruit `INITR_BLACKTAB`. Cheap 1.8" ST7735S + SD modules (G-176).
    black
}

pub struct Geom {
    width: i32
    height: i32
    x0: i32
    y0: i32
    madctl: i32
}

pub struct Rect {
    x: i32
    y: i32
    w: i32
    h: i32
}

/// Geometry for a tab. `Tab.black`: 128×160, origin 0, MADCTL `0xC8` (MX|MY|BGR).
pub fn geom_for(tab: Tab): Geom {
    match tab {
        Tab.black {
            return Geom{ width: 128, height: 160, x0: 0, y0: 0, madctl: 0xC8 }
        }
        else {
            return Geom{ width: 128, height: 160, x0: 0, y0: 0, madctl: 0xC8 }
        }
    }
}

/// Adafruit BLACKTAB MADCTL for rotation `0..=3` (MX/MY/MV | BGR).
pub fn madctl_black(rot: i32): i32 {
    if rot == 1 {
        return 0xA8
    }
    if rot == 2 {
        return 0x08
    }
    if rot == 3 {
        return 0x68
    }
    return 0xC8
}

/// Geometry after `set_rotation`. Landscape (`1`, `3`) swaps width/height.
pub fn geom_rotated(tab: Tab, rot: i32): Geom {
    let base = geom_for(tab)
    let madctl = madctl_black(rot)
    if rot == 1 {
        return Geom{ width: base.height, height: base.width, x0: base.y0, y0: base.x0, madctl: madctl }
    }
    if rot == 3 {
        return Geom{ width: base.height, height: base.width, x0: base.y0, y0: base.x0, madctl: madctl }
    }
    return Geom{ width: base.width, height: base.height, x0: base.x0, y0: base.y0, madctl: madctl }
}

/// Clip a rectangle to `[0, width) × [0, height)`. Empty → `w == 0` or `h == 0`.
pub fn clip_rect(x: i32, y: i32, w: i32, h: i32, width: i32, height: i32): Rect {
    let mut xx = x
    let mut yy = y
    let mut ww = w
    let mut hh = h
    if xx < 0 {
        ww = ww + xx
        xx = 0
    }
    if yy < 0 {
        hh = hh + yy
        yy = 0
    }
    if xx + ww > width {
        ww = width - xx
    }
    if yy + hh > height {
        hh = height - yy
    }
    if ww < 0 {
        ww = 0
    }
    if hh < 0 {
        hh = 0
    }
    return Rect{ x: xx, y: yy, w: ww, h: hh }
}

/// Clamp a corner radius so `2*r` fits in `w` and `h`. Negative → `0`.
pub fn clamp_radius(w: i32, h: i32, r: i32): i32 {
    let mut rr = r
    if rr < 0 {
        rr = 0
    }
    let mw = w / 2
    let mh = h / 2
    if rr > mw {
        rr = mw
    }
    if rr > mh {
        rr = mh
    }
    return rr
}

/// Largest `dx >= 0` with `dx*dx + dy*dy <= r*r`. Empty circle → `0`.
pub fn circle_dx(r: i32, dy: i32): i32 {
    if r <= 0 {
        return 0
    }
    let mut d = dy
    if d < 0 {
        d = 0 - d
    }
    if d > r {
        return 0
    }
    let lim = r * r
    let mut dx: i32 = 0
    while dx * dx + d * d <= lim {
        dx = dx + 1
    }
    return dx - 1
}
