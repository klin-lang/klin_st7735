module app
import klin_st7735 lcd

fn main() {
    printf("klin_st7735 %d\n", lcd.version())
    printf("blacktab %dx%d\n", lcd.geom_for(lcd.Tab.black).width, lcd.geom_for(lcd.Tab.black).height)
    printf("rot1 %dx%d\n", lcd.geom_rotated(lcd.Tab.black, 1).width, lcd.geom_rotated(lcd.Tab.black, 1).height)
    printf("red %d\n", lcd.color_red())
    printf("font %dx%d\n", lcd.font_char_w(), lcd.font_char_h())
    printf("rclamp %d\n", lcd.clamp_radius(20, 10, 100))
}
